PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/prostuti?sslmode=require
JWT_SECRET=your-super-secret-jwt-key
BOOTSTRAP_TOKEN=your-bootstrap-token

# Redis Configuration (Dual Upstash REST and TCP TLS support with in-memory fallback)
# Primary: Upstash HTTP REST (Stateless, optimal for serverless/Render cold starts)
# UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Secondary: TCP / TLS Redis connection string
REDIS_URL=redis://localhost:6379
# For Upstash TCP TLS:
# REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379

# Google OAuth (Optional)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
