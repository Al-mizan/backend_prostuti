model ExamAttempt {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  modelTestId      String?   @map("model_test_id") @db.Uuid
  examSession      String    @map("exam_session")
  startedAt        DateTime  @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  timeTakenSeconds Int?      @map("time_taken_seconds")
  score            Int?

  user                 User                  @relation(fields: [userId], references: [id])
  modelTest            ModelTest?            @relation(fields: [modelTestId], references: [id])
  examAttemptQuestions ExamAttemptQuestion[]

  @@map("exam_attempts")
}

model ExamAttemptQuestion {
  attemptId  String @map("attempt_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  orderIndex Int    @map("order_index")

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id])
  question Question    @relation(fields: [questionId], references: [id])

  @@id([attemptId, questionId])
  @@map("exam_attempt_questions")
}

model ModelTest {
  id              String        @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  examSession     String        @map("exam_session")
  durationMinutes Int           @default(120) @map("duration_minutes")
  totalMarks      Float         @default(200.0) @map("total_marks")
  totalQuestions  Int           @default(200) @map("total_questions")
  startTime       DateTime      @map("start_time")
  endTime         DateTime      @map("end_time")
  isPublished     Boolean       @default(true) @map("is_published")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  examAttempts    ExamAttempt[]

  @@map("model_tests")
}
